{
  "providers": {
    "zai": {
      "apiKey": "Z_AI_API_KEY",
      "modelOverrides": {
        "glm-5.1":     { "name": "GLM-5.1 (z.ai sub · default)" },
        "glm-5-turbo": { "name": "GLM-5-Turbo (z.ai sub · fast)" }
      }
    },
    "openai-codex": {
      "modelOverrides": {
        "gpt-5.5":     { "name": "GPT-5.5 (ChatGPT sub)" },
        "gpt-5.4":     { "name": "GPT-5.4 (ChatGPT sub · fast)" }
      }
    },
    "openrouter": {
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKey": "OPENROUTER_API_KEY",
      "api": "openai-completions",
