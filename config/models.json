        {
          "id": "anthropic/claude-opus-4.6",
          "name": "Opus 4.6 (arch / hard problems)",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 1000000,
          "maxTokens": 128000
        }
      ],
      "modelOverrides": {
        "moonshotai/kimi-k2-thinking":    { "name": "Kimi K2 Thinking (cheap thinking)" },
        "anthropic/claude-sonnet-4.6":    { "name": "Sonnet 4.6 (backup)" },
        "google/gemini-3-flash-preview":  { "name": "Gemini 3 Flash (fast backup)" }
      }
    },
    "llama": {
      "baseUrl": "http://llm.pi:8080/v1",
      "api": "openai-completions",
      "apiKey": "none",
      "models": [
        {
          "id": "qwen-9b",
          "name": "Qwen3.5 9B (local · fast)",
          "reasoning": true,
          "contextWindow": 32768,
          "maxTokens": 8192
        },
        {
          "id": "qwen-35b",
          "name": "Qwen3.6 35B MoE (local · smart)",
          "reasoning": true,
          "contextWindow": 32768,
          "maxTokens": 8192
        }
      ]
    }
  }
