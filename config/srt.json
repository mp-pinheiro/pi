{
  "network": {
    "allowedDomains": ["openrouter.ai", "*.openrouter.ai", "api.search.brave.com", "api.z.ai", "chatgpt.com", "*.openai.com", "api.exa.ai", "llm.pi", "dev.pi", "localhost"],
    "deniedDomains": [],
    "allowAllUnixSockets": true
  },
  "filesystem": {
    "denyRead":  ["~"],
    "allowRead":  [".", "~/.pi/agent", "~/.pi/skills", "~/.local", "~/.npmrc", "~/.gitconfig"],
    "allowWrite": [".", "~/.pi/sessions", "~/.pi/memory", "~/.pi/agent", "/tmp"],
    "denyWrite":  []
  },
  "seccomp": {
    "applyPath": "/usr/local/bin/apply-seccomp"
  }
}
